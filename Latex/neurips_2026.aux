\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Three contributions map onto three necessary properties: C1 unifies five modalities via cross-modal hyperedges (T1, T2), C2 maintains lifecycle consistency on the live hypergraph (T5), and C3 routes queries among subgraph retrieval, community synthesis, and knowledge discovery (T3, T4, T6). KnowledgeClaw obtains the highest scoring on all six OmniKE tasks (OKE\,$=$\,59.8).}}{2}{figure.2}\protected@file@percent }
\newlabel{F2}{{2}{2}{Three contributions map onto three necessary properties: C1 unifies five modalities via cross-modal hyperedges (T1, T2), C2 maintains lifecycle consistency on the live hypergraph (T5), and C3 routes queries among subgraph retrieval, community synthesis, and knowledge discovery (T3, T4, T6). KnowledgeClaw obtains the highest scoring on all six OmniKE tasks (OKE\,$=$\,59.8)}{figure.2}{}}
\citation{RAGAS}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {(A)} Six OmniKE tasks covering construction (T1 acquisition, T2 cross-modal coreference), maintenance (T5 lifecycle consistency), and application (T3 multi-hop, T4 cross-modal, T6 discovery). \textbf  {(B)} OmniKE-Bench: 10 personas, 10 domains, 5 modalities, and 4{,}544 real files.}}{3}{figure.3}\protected@file@percent }
\newlabel{F3}{{3}{3}{\textbf {(A)} Six OmniKE tasks covering construction (T1 acquisition, T2 cross-modal coreference), maintenance (T5 lifecycle consistency), and application (T3 multi-hop, T4 cross-modal, T6 discovery). \textbf {(B)} OmniKE-Bench: 10 personas, 10 domains, 5 modalities, and 4{,}544 real files}{figure.3}{}}
