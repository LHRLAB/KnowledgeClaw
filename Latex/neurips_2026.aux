\citation{GraphRAG,LightRAG}
\citation{HyperGraphRAG}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {KnowledgeClaw} methodology, where C1--C3 build, maintain, and serve an omnimodal knowledge hypergraph. \textbf  {(A)} C1 extracts entities from text, PDF, image, audio, and video and fuses them via within-modality canonicalization and cross-modal coreference into typed hyperedges. \textbf  {(B)} C2 closes the lifecycle loop via a Build--Query--Reason--Update pass with orphan eviction and fact refresh. \textbf  {(C)} C3 routes queries among subgraph retrieval, community synthesis, and discovery.}}{4}{figure.4}\protected@file@percent }
\newlabel{F4}{{4}{4}{\textbf {KnowledgeClaw} methodology, where C1--C3 build, maintain, and serve an omnimodal knowledge hypergraph. \textbf {(A)} C1 extracts entities from text, PDF, image, audio, and video and fuses them via within-modality canonicalization and cross-modal coreference into typed hyperedges. \textbf {(B)} C2 closes the lifecycle loop via a Build--Query--Reason--Update pass with orphan eviction and fact refresh. \textbf {(C)} C3 routes queries among subgraph retrieval, community synthesis, and discovery}{figure.4}{}}
