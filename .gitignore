*/.knowledgeclaw/
*/.openclaw/

# Media expression directory (extracted PDF page images, audio segments,
# video clips). Generated on demand by the ingestion pipeline; can be huge.
expr/

# Benchmark output (table1.md / table1.json land here)
results/

# Reference papers and other large binaries — do NOT commit, fetch separately
*.pdf
!benchmarks/**/*.pdf

# Lifecycle audit log (per-storage-dir, never commit)
lifecycle.jsonl

# ─── DO commit these (whitelist overrides) ───────────────────────────────────
!.env.example

